# Database Configuration (Postgres de test en Docker, ver docker-compose.test.yml)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=guniversity_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_DEBUG=false

# Server Configuration
NODE_ENV=test

# Frontend URL (usado para armar links de mails, ej. activación de cuenta)
FRONTEND_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=test-jwt-secret

# Resend (deshabilitado en test: MailService no debe lanzar si falla el envío)
RESEND_API_KEY=re_dummy_key
EMAIL_FROM=Guniverse <noreply@test.local>
ADMIN_NOTIFICATION_EMAIL=
RESEND_BCC=

# Cloudinary (no usado en los tests e2e actuales)
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
