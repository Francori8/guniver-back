# Database Configuration (uso local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guniversity
DB_USER=postgres
DB_PASSWORD=root
DB_DEBUG=false

# En Railway (u otro PaaS) se usa esta variable en vez de las DB_* de arriba.
# Railway la inyecta sola al conectar un servicio Postgres al backend.
# DATABASE_URL=postgres://user:password@host:port/dbname
# DB_SSL=false  # solo si el Postgres de destino no soporta/exige SSL

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (usado para armar links de mails, ej. activación de cuenta)
FRONTEND_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Resend (mails de solicitud de acceso / invitación)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Guniverse <noreply@yourdomain.com>
# Fuera de NODE_ENV=production, TODOS los mails (a usuarios y a admins) se
# redirigen acá en vez de al destinatario real — evita spamear gente real cuando
# se corre localmente con datos importados de un dump de producción.
ADMIN_NOTIFICATION_EMAIL=your-admin-email@example.com
# Se copia (BCC) en todos los mails que manda el sistema
RESEND_BCC=logs@yourdomain.com

# Cloudinary (subida de archivos de materiales de estudio)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CallMeBot — alertas de errores (4xx/5xx) por WhatsApp (callmebot.com)
# CALLMEBOT_PHONE=549XXXXXXXXXX   (número internacional sin +, ej: 5491122334455)
# CALLMEBOT_APIKEY=               (la API key que te manda CallMeBot por WhatsApp)
